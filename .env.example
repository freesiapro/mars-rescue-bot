BOT_TOKEN=your_bot_token_here
DB_PATH=bot.db
# 可选：文本去重 HMAC 密钥。未配置时回退到 BOT_TOKEN。
# 更换密钥会导致历史文本去重记录无法命中。
# DEDUP_SECRET=change_me
# 可选：排行榜周界时区，默认 Asia/Shanghai，周一为一周起点。
# STATS_TZ=Asia/Shanghai
# 可选：数据保留天数，默认 180；非法或非正数会回退到 180。
# 启动时执行一次清理，之后每 24 小时执行一次。
# DATA_RETENTION_DAYS=180
# 代理配置，支持 http / https / socks5
# PROXY_URL=http://127.0.0.1:7890
# PROXY_URL=socks5://127.0.0.1:1080
